{
    "name": "fastd/fastd",
    "type": "library",
    "license": "MIT",
    "description": "A High Performance API Framework By Swoole Extension",
    "minimum-stability": "dev",
    "keywords": ["FastD", "api", "container", "http-message", "http-server-handler", "http-server-middle", "cache"],
    "homepage": "https://fastdlabs.com/",
    "authors": [
        {
            "name": "janhuang",
            "email": "bboyjanhuang@gmail.com"
        },
        {
            "name": "longxinhui",
            "email": "longxinhui@php.net"
        }
    ],
    "autoload": {
        "psr-4": {
            "FastD\\": "src"
        },
        "files": [
            "helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\": "tests"
        }
    },
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "fastd/container": "dev-develop",
        "fastd/config": "dev-develop",
        "fastd/middleware": "dev-develop",
        "fastd/swoole": "dev-develop",
        "fastd/http": "dev-develop",
        "fastd/routing": "dev-develop",
        "fastd/medoodb": "dev-develop",
        "fastd/cache": "dev-develop",
        "monolog/monolog": "^3.0",
        "symfony/console": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "swoole/ide-helper": "@dev"
    },
    "suggest": {
        "fastd/swoole": "Can effectively improve performance。"
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env.yml') || copy('.env.yml.example', '.env.yml');\""
        ]
    },
    "bin": [
        "console",
        "process",
        "server"
    ]
}
