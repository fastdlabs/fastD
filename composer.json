{
    "name": "fastd/fastd",
    "type": "library",
    "license": "MIT",
    "description": "The FastD High Performance API Framework",
    "minimum-stability": "dev",
    "keywords": ["Framework", "API", "Swoole", "FastD"],
    "homepage": "https://fastdlabs.com/",
    "authors": [
        {
            "name": "janhuang",
            "email": "bboyjanhuang@gmail.com"
        },
        {
            "name": "longxinhui",
            "email": "longxinhui@php.net"
        }
    ],
    "autoload": {
        "psr-4": {
            "FastD\\": "src"
        },
        "files": [
            "helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\": "tests"
        }
    },
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "fastd/container": "dev-develop",
        "fastd/config": "dev-develop",
        "fastd/middleware": "dev-develop",
        "fastd/swoole": "dev-develop",
        "fastd/http": "dev-develop",
        "fastd/routing": "dev-develop",
        "monolog/monolog": "^3.0",
        "symfony/console": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "swoole/ide-helper": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "/Users/janhuang/PhpstormProjects/fastd/container"
        },
        {
            "type": "path",
            "url": "/Users/janhuang/PhpstormProjects/fastd/config"
        },
        {
            "type": "path",
            "url": "/Users/janhuang/PhpstormProjects/fastd/middleware"
        },
        {
            "type": "path",
            "url": "/Users/janhuang/PhpstormProjects/fastd/swoole"
        },
        {
            "type": "path",
            "url": "/Users/janhuang/PhpstormProjects/fastd/http"
        },
        {
            "type": "path",
            "url": "/Users/janhuang/PhpstormProjects/fastd/routing"
        }
    ],
    "suggest": {
        "fastd/swoole": "Can effectively improve performance。"
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env.yml') || copy('.env.yml.example', '.env.yml');\""
        ]
    },
    "bin": [
        "terminal",
        "process",
        "server"
    ]
}
