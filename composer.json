{
    "name": "fastd/fastd",
    "type": "library",
    "license": "MIT",
    "description": "High-performance PHP API framework based on PSR standards and Swoole.",
    "keywords": [
        "FastD",
        "api",
        "container",
        "http-message",
        "http-server-handler",
        "http-server-middle",
        "cache"
    ],
    "homepage": "https://fastdlabs.com/",
    "authors": [
        {
            "name": "janhuang",
            "email": "bboyjanhuang@gmail.com"
        },
        {
            "name": "longxinhui",
            "email": "longxinhui@php.net"
        }
    ],
    "autoload": {
        "psr-4": {
            "FastD\\": "src"
        },
        "files": [
            "helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\": "tests",
            "app\\": "tests/app/"
        }
    },
    "require": {
        "php": ">=8.4.1",
        "ext-json": "*",
        "fastd/event": "^8.0",
        "fastd/container": "^8.1",
        "fastd/config": "^8.0",
        "fastd/middleware": "^8.0",
        "fastd/http": "^8.1",
        "fastd/routing": "^8.1",
        "fastd/swoole": "^8.1",
        "monolog/monolog": "^3.0",
        "symfony/console": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "swoole/ide-helper": "@dev",
        "phpstan/phpstan": "^2.3"
    },
    "suggest": {
        "fastd/cache": "Optional cache component for applications that need caching.",
        "fastd/medoodb": "Optional MedooDB component for applications that need a database."
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env.yml') || copy('.env.yml.example', '.env.yml');\""
        ]
    },
    "bin": [
        "console",
        "process",
        "server"
    ]
}
